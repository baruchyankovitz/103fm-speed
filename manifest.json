{
  "manifest_version": 3,
  "name": "מאיץ רדיו – מהירות השמעה ל־103FM, גלצ וכאן",
  "version": "3.5",
  "description": "נגן מודרני לתוכניות רדיו מוקלטות ב־103FM, גלי צה״ל וכאן: מהירות השמעה, דילוגים, טיימר שינה, נגן צף ושיתוף קטעים",
  "permissions": ["storage"],
  "host_permissions": ["*://*.maariv.co.il/*", "*://*.glz.co.il/*", "*://glz.co.il/*", "*://*.kan.org.il/*"],
  "background": {
    "service_worker": "src/background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://*.maariv.co.il/*", "*://*.glz.co.il/*", "*://glz.co.il/*", "*://*.kan.org.il/*"],
      "js": ["src/content/bridge.js"],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": ["*://*.maariv.co.il/*", "*://*.glz.co.il/*", "*://glz.co.il/*", "*://*.kan.org.il/*"],
      "js": ["src/content/content.js", "src/content/player.js"],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Radio Speed",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "author": "Baruch Yankovitz",
  "homepage_url": "https://portfolio-upgrade-xi.vercel.app/"
}
