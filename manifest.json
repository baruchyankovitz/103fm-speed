{
  "manifest_version": 3,
  "name": "מאיץ השמעה לרדיו הישראלי",
  "version": "3.0",
  "description": "נגן מודרני לתוכניות רדיו מוקלטות ב־103FM, גלי צה״ל וכאן: מהירות השמעה, דילוגים, טיימר שינה, נגן צף ושיתוף קטעים",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.maariv.co.il/*",
    "*://*.glz.co.il/*",
    "*://glz.co.il/*",
    "*://*.kan.org.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.maariv.co.il/*",
        "*://*.glz.co.il/*",
        "*://glz.co.il/*",
        "*://*.kan.org.il/*"
      ],
      "js": [
        "bridge.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.maariv.co.il/*",
        "*://*.glz.co.il/*",
        "*://glz.co.il/*",
        "*://*.kan.org.il/*"
      ],
      "js": [
        "content.js",
        "player.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Radio Speed",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  },
  "author": "Baruch Yankovitz",
  "homepage_url": "https://www.linkedin.com/in/baruch-yankovitz"
}
