{
  "manifest_version": 3,
  "name": "מאיץ השמעה ל־103FM",
  "version": "1.2",
  "description": "השמעת תוכניות 103FM במהירות מותאמת, עם קיצורי מקלדת וזכירת מיקום",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "*://*.maariv.co.il/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://*.maariv.co.il/*"
      ],
      "js": [
        "bridge.js"
      ],
      "css": [
        "ui.css"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*.maariv.co.il/*"
      ],
      "js": [
        "content.js"
      ],
      "all_frames": true,
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "103FM Speed",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}